  "itineraries": [
   {
    "id": 5635,
    "title": "روز اول | آغاز سفر",
    "description": "سه شنبه شب ساعت 22 از تهران به سمت شهر جهانی یزد حرکت میکنیم",
    "day_number": 1,
    "display_order": 1
   },
   {
    "id": 5636,
    "title": "روز دوم | قدم‌زدن در قلب تاریخ یزد",
    "description": "صبح روز بعد (چهارشنبه) به شهر جهانی یزد میرسیم، بعد از صرف صبحانه  در بزرگترین هتل یزد هتل 5 ستاره ارگ، سفرمان را با قدم‌زدن در بافت تاریخی یزد همراه با لیدر مجرب آغاز می‌کنیم ؛ جایی که دیوارهای خشتی ، کوچه‌های باریک و معماری اصیل کویری ، حال‌ و هوای یزد قدیم را زنده نگه داشته‌اند.\r\nدر این مسیر از م",
    "day_number": 2,
    "display_order": 2
   },
   {
    "id": 5637,
    "title": "روز سوم | از چک‌ چک زرتشتیان تا میبد؛ در مسیر تاریخ و هنر",
    "description": "پس از صرف صبحانه در هتل، ساعت ۷ صبح راهی یکی از مقدس ترین مکان های زرتشتیان جهان یعنی زیارتگاه چک‌ چک اردکان می‌شویم؛ زیارتگاهی که در دل کوه و میان صخره‌های خشک و آرام منطقه قرار گرفته و فضایی متفاوت و معنوی را پیش روی مسافران می‌گذارد.\r\nساعت ۱۱ به سمت میبد حرکت می‌کنیم ؛ شهری کهن با نشانه‌هایی از ت",
    "day_number": 3,
    "display_order": 3
   },
   {
    "id": 5638,
    "title": "روز چهارم | آخرین روایت ؛ از آتشکده و دخمه زرتشتیان تا بازگشت",
    "description": "پس از صرف صبحانه ، آخرین روز سفر را با بازدید از آتشکده یزد آغاز می‌کنیم ؛ مکانی که آتش مقدس زرتشتیان در آن نگهداری می‌شود و یکی از شناخته‌ شده‌ترین نمادهای میراث زرتشتی یزد به شمار می‌رود.\r\nدر ادامه به دخمه زرتشتیان می‌رویم ؛ بنایی تاریخی در ارتفاعات یزد که ما را با بخشی از آیین‌ها و شیوه‌های تدفین",
    "day_number": 4,
    "display_order": 4
   }
  ],
